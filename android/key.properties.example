# Copy this file to android/key.properties, keep it mode 600, and replace
# every placeholder. The keystore and password file must be absolute paths
# outside the repo. The password file should contain only the shared store/key
# password and must also be mode 600.
storeFile=/absolute/path/outside/repository/opk-terminal-upload.p12
storeType=PKCS12
passwordFile=/absolute/path/outside/repository/opk-terminal-upload.password
keyAlias=opk-terminal-upload
